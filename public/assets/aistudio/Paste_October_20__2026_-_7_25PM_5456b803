package blooddonation;

import java.io.IOException;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

@WebServlet("/searchDonors")
public class DonorSearchServlet extends HttpServlet {

    protected void doGet(
            HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        String bloodGroup =
                request.getParameter("bloodGroup");

        String compatibleGroups;

        if (bloodGroup.equalsIgnoreCase("A+")) {

            compatibleGroups =
                    "'A+','A-','O+','O-'";

        } else if (bloodGroup.equalsIgnoreCase("A-")) {

            compatibleGroups =
                    "'A-','O-'";

        } else if (bloodGroup.equalsIgnoreCase("B+")) {

            compatibleGroups =
                    "'B+','B-','O+','O-'";

        } else if (bloodGroup.equalsIgnoreCase("B-")) {

            compatibleGroups =
                    "'B-','O-'";

        } else if (bloodGroup.equalsIgnoreCase("AB+")) {

            compatibleGroups =
                    "'A+','A-','B+','B-','AB+','AB-','O+','O-'";

        } else if (bloodGroup.equalsIgnoreCase("AB-")) {

            compatibleGroups =
                    "'A-','B-','AB-','O-'";

        } else if (bloodGroup.equalsIgnoreCase("O+")) {

            compatibleGroups =
                    "'O+','O-'";

        } else if (bloodGroup.equalsIgnoreCase("O-")) {

            compatibleGroups =
                    "'O-'";

        } else {

            response.getWriter().println(
                    "Invalid blood group."
            );

            return;
        }

        String sql =
                "SELECT * FROM donors " +
                "WHERE blood_group IN (" +
                compatibleGroups +
                ") " +
                "AND eligible = 'YES' " +
                "AND recent_illness = 'NO' " +
                "ORDER BY city, name";

        try {

            Connection con =
                    DatabaseConnection.getConnection();

            PreparedStatement pst =
                    con.prepareStatement(sql);

            ResultSet rs =
                    pst.executeQuery();

            response.setContentType(
                    "text/html"
            );

            response.getWriter().println(
                    "<html>" +
                    "<head>" +
                    "<title>Matching Donors</title>" +
                    "<link rel='stylesheet' " +
                    "href='css/style.css'>" +
                    "</head>" +
                    "<body>"
            );

            response.getWriter().println(
                    "<div class='container'>"
            );

            response.getWriter().println(
                    "<h2>Matching Eligible Donors</h2>"
            );

            response.getWriter().println(
                    "<table>"
            );

            response.getWriter().println(
                    "<tr>" +
                    "<th>Name</th>" +
                    "<th>Blood Group</th>" +
                    "<th>City</th>" +
                    "<th>Phone</th>" +
                    "<th>Email</th>" +
                    "</tr>"
            );

            boolean found = false;

            while (rs.next()) {

                found = true;

                response.getWriter().println(
                        "<tr>" +

                        "<td>" +
                        rs.getString("name") +
                        "</td>" +

                        "<td>" +
                        rs.getString("blood_group") +
                        "</td>" +

                        "<td>" +
                        rs.getString("city") +
                        "</td>" +

                        "<td>" +
                        rs.getString("phone") +
                        "</td>" +

                        "<td>" +
                        rs.getString("email") +
                        "</td>" +

                        "</tr>"
                );
            }

            response.getWriter().println(
                    "</table>"
            );

            if (!found) {

                response.getWriter().println(
                        "<p>" +
                        "No suitable eligible donor found." +
                        "</p>"
                );
            }

            response.getWriter().println(
                    "<br>" +
                    "<a href='hospital-dashboard.jsp'>" +
                    "Back to Hospital Dashboard" +
                    "</a>"
            );

            response.getWriter().println(
                    "</div>" +
                    "</body>" +
                    "</html>"
            );

            rs.close();
            pst.close();
            con.close();

        } catch (Exception e) {

            e.printStackTrace();

            response.getWriter().println(
                    "Database error."
            );
        }
    }
}

